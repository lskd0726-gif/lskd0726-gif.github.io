# index.html 은 늘 새로 확인한다 — 배포 직후 옛 화면이 남지 않게.
# 번들·폰트는 이름에 해시가 붙어 있어 오래 캐시해도 안전하다.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/expo-static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
